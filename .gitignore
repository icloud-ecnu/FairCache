### ========== LMCache 规则 ========== ###
# Python 编译文件
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Vim 临时文件
**/.*.sw*

# 二进制文件
**/*.pt
**/*.so
**/*.pkl
**/*.mo
**/*.pot

# Jupyter 临时文件
**/.ipynb_checkpoints

# 性能报告文件
**/*.nsys-rep
**/*.sqlite

# 单元测试覆盖率报告
**/.tox/
**/.nox/
**/.coverage
**/.coverage.*
**/.cache
**/nosetests.xml
**/coverage.xml
**/*.cover
**/.hypothesis/
**/.pytest_cache/

# 虚拟环境
**/.env
**/.venv
**/env/
**/venv/
**/ENV/
**/env.bak/
**/venv.bak/

# IDE 配置
**/.idea/
**/.vscode/
**/.spyderproject
**/.spyproject
**/.ropeproject

# 操作系统文件
**/.DS_Store

# 数据库文件
**/db.sqlite3
**/db.sqlite3-journal

# 生成文件
**/generated/

# 构建产物 (精确到子项目)
LMCache/build/
LMCache/dist/
LMCache/develop-eggs/
LMCache/downloads/
LMCache/eggs/
LMCache/.eggs/
LMCache/lib/
LMCache/lib64/
LMCache/parts/
LMCache/sdist/
LMCache/var/
LMCache/wheels/
LMCache/share/python-wheels/
LMCache/*.egg-info/
LMCache/.installed.cfg
LMCache/*.egg
LMCache/MANIFEST

# PyInstaller 相关
LMCache/*.manifest
LMCache/*.spec

# 安装日志
LMCache/pip-log.txt
LMCache/pip-delete-this-directory.txt

# 测试报告与覆盖率
LMCache/htmlcov/
LMCache/.tox/
LMCache/.nox/
LMCache/.coverage
LMCache/.coverage.*
LMCache/.cache
LMCache/nosetests.xml
LMCache/coverage.xml
LMCache/*.cover
LMCache/*.py,cover
LMCache/.hypothesis/
LMCache/.pytest_cache/
LMCache/cover/

# Jupyter 临时文件
**/.ipynb_checkpoints

# Vim 临时文件
**/.*.sw*

# 其他
LMCache/outdated/
LMCache/perf-test.py
LMCache/*.prof
LMCache/*.so
LMCache/.ycm_extra_conf.py

# 实验性测试目录
LMCache/lmcache/experimental/tests

# 示例文件
LMCache/examples/example_local.yaml
LMCache/examples/openai_chat_completion_client_local.py
LMCache/lmcache/experimental/examples

# 示例输出
**/offline_inference_outputs.jsonl
LMCache/examples/offline_inference/offline_inference_outputs.jsonl
LMCache/examples/save_decode_cache/offline_inference_outputs.jsonl
LMCache/examples/offline_inference/buggy_example.py
LMCache/examples/test_example/

# 磁盘缓存
LMCache/remote_disk/
LMCache/local_disk/
LMCache/tests/local_disk/
LMCache/tests/remote_disk/
**/*.pt  # 全局忽略所有PT文件

# 脚本目录
LMCache/misc_scripts/

# 性能报告
**/*.nsys-rep
**/*.sqlite

# 文档构建
LMCache/docs/build/
LMCache/docs/build.sh
LMCache/docs/output/

# 临时目录
LMCache/try/

# CUDA 内核文件
LMCache/csrc/temp.cu

### ========== 全局通用规则 ========== ###
