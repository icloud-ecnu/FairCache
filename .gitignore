**/__pycache__/
**/*.py[cod]
**/*$py.class

# Vim 临时文件
**/.*.sw*

# PyTorch 模型文件
**/*.pt

# Jupyter 临时文件
**/.ipynb_checkpoints

# 性能报告文件
**/*.nsys-rep
**/*.sqlite




